// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Модел за Каталога с Къщи
model House {
  id               String   @id @default(cuid())
  slug             String?  @unique // Уникален кратък адрес за SEO (напр. "model-a-75sqm")
  name             String
  area             Float    // Квадратура
  bedrooms         Int      // Брой спални
  bathrooms        Int      // Брой бани
  toilets          Int      @default(1) // Брой тоалетни
  floors           Int      @default(1) // Етажи
  terraces         Int      @default(0) // Тераси
  price            String   // Цена (съхраняваме я като чист низ "250000")
  description      String?  @db.Text
  imageUrl         String?  // Път към главната снимка
  gallery          String[] // Галерия от допълнителни снимки
  tags             String[] // Тагове (напр. ["Енергоефективна", "Премиум"])

  // SEO ОПТИМИЗАЦИЯ ЗА ГООГЛЕ
  metaTitle        String?  // Индивидуално SEO заглавие
  metaDescription  String?  @db.Text // Индивидуално SEO описание

  // ТЕХНИЧЕСКИ ХАРАКТЕРИСТИКИ
  constructionType String?  // Вид конструкция (напр. "Масивна метална")
  profileSize      String?  // Размери на профилите (напр. "100х100х5 мм")
  wallThickness    String?  // Дебелина на стената (напр. "25 см")
  wallTech         String?  // Технология на стената (напр. "Дишаща система БИОЗИД")
  roofType         String?  // Вид покрив (напр. "Двускатен / Плосък")
  windowsType      String?  // Вид дограма (напр. "7-камерна PVC, троен стъклопакет")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([slug])
  @@index([createdAt])
}

// Модел за Клиентските заявки от Калкулатора
model QuoteRequest {
  id           String   @id @default(cuid())
  clientName   String
  clientPhone  String
  totalArea    Float
  status       String   @default("new") // new, in_progress, completed
  underlayUrl  String?  // Линк към качената подложка (чертеж)
  cadData      Json?    // Масив със стени и панели за CAD редактора
  
  // --- ПОЛЕ ЗА СЛУЖЕБНИЯ ПАНЕЛ (ЕТАЖИ И ПОДЛОЖКИ) ---
  floorsData   Json?    // Масив с етажите, ppm мащаба и специфичните подложки за всеки етаж
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Модел за Блог статии (Автоматизирани през Make.com / Soro.ai)
model BlogPost {
  id              String   @id @default(cuid())
  slug            String?  @unique // Уникален кратък адрес за SEO (напр. "zashhto-da-izberem-konopena-kashta")
  title           String
  content         String   @db.Text
  excerpt         String?  @db.Text
  imageUrl        String?

  // SEO ОПТИМИЗАЦИЯ ЗА ГООГЛЕ
  metaTitle       String?  // Индивидуално SEO заглавие
  metaDescription String?  @db.Text // Индивидуално SEO описание
  
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@index([slug])
  @@index([publishedAt])
}